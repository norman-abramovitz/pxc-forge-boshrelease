name: pxc-blacksmith-plans

packages: []

templates:
  bin/configure-blacksmith: bin/configure-blacksmith

  plans/service.yml: plans/service.yml

  plans/standalone/manifest.yml:    plans/standalone/manifest.yml
  plans/standalone/credentials.yml: plans/standalone/credentials.yml
  plans/standalone/init:            plans/standalone/init

  plans/cluster/manifest.yml:       plans/cluster/manifest.yml
  plans/cluster/credentials.yml:    plans/cluster/credentials.yml
  plans/cluster/init:               plans/cluster/init

properties:
  environment:
    description: "The environment name of the Blacksmith deployment"

  bosh_env:
    description: "The environment name of the BOSH director that deploys the service instances"

  stemcell_os:
    description: "Stemcell OS for service instance deployments (ubuntu-noble or ubuntu-resolute)"
    default: ubuntu-noble

  stemcell_version:
    description: "Stemcell version for service instance deployments"
    default: latest

  pxc_release.version:
    description: "Version of pxc-release that service instance deployments use"
    default: "2.0.15"

  pxc_release.url:
    description: "URL of the pxc-release tarball"
    default: "https://bosh.io/d/github.com/cloudfoundry/pxc-release?v=2.0.15"

  pxc_release.sha1:
    description: "Checksum of the pxc-release tarball"
    default: "3bb8ac90fde574c55cb9f405a67f2bac71207485"

  pxc_release.stemcell:
    description: "For a compiled pxc-release tarball: the stemcell it was compiled on, as os and version. Leave unset for the source release."

  bpm_release.version:
    description: "Version of the bpm release that service instance deployments use. Stemcells without runit need 1.4.41 or later."
    default: "1.4.41"

  bpm_release.url:
    description: "URL of the bpm release tarball"
    default: "https://bosh.io/d/github.com/cloudfoundry/bpm-release?v=1.4.41"

  bpm_release.sha1:
    description: "Checksum of the bpm release tarball"
    default: "sha256:7b445508d63d2171d892ba33f836087e1e519b9782f44c5fa5290323616ca8e6"

  service.id:
    description: "Machine-friendly name for this service."
    default: pxc

  service.name:
    description: "Human-friendly name for this service, to be displayed in the Cloud Foundry marketplace."
    default: pxc

  service.description:
    description: "A description for this service, to be displayed in the Cloud Foundry marketplace."
    default: "A dedicated MySQL 8.4 (Percona XtraDB Cluster) instance."

  service.tags:
    description: "List of tags to apply to service instances."
    default: [blacksmith, dedicated, mysql, pxc]

  service.limit:
    description: "A global limit on the number of pxc services (regardless of the plan); 0 = unlimited."
    default: 0

  plans:
    description: |
      A map of plans, keyed by plan id.  i.e.:

        single:
          name: standalone
          description: A single MySQL 8.4 server, with no replication
          limit: 7
          type: standalone
          vm_type: default

        ha:
          name: cluster
          description: A 3-node Galera cluster behind 2 proxies
          limit: 4
          type: cluster
          vm_type: default
          proxy_vm_type: small

      Keys:
        name, description, limit   marketplace entry; limit 0 = unlimited
        type            standalone (1 node) or cluster (3 nodes + 2 proxies)
        vm_type         VM type of the MySQL nodes (default: default)
        proxy_vm_type   cluster only: VM type of the proxies (default: vm_type)
        network         network name (default: pxc-service)
        azs             list of AZs (default: [z1])
        disk            persistent disk in MB (default: 10240)
        disk_type       persistent disk type from the cloud config; wins over disk
        tls_required    refuse connections without TLS (default: false)
